<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.0</Version>
    <Authors>Standard Envelope Working Group</Authors>
    <Description>Enterprise-grade value correspondence. Independent parody project.</Description>
  </PropertyGroup>
</Project>
